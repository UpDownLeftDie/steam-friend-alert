{
  "name": "steam-friend-alert",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "start:once": "tsx src/cli.ts --once",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "wrangler types && eslint . && tsc --noEmit",
    "lint:fix": "wrangler types && eslint . --fix && tsc --noEmit"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "workers-mini-admin": "^0.1.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-narwhal": "^1.0.2",
    "typescript": "npm:@typescript/typescript6",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.147.0"
  }
}
